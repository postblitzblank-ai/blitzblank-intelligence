# Postgres (Supabase oder Neon)
DATABASE_URL=postgresql://user:password@host:5432/blitzblank

# Anthropic Claude API (KI-Schicht)
ANTHROPIC_API_KEY=

# Google OAuth (Login + Gmail + Search Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Cron-Job-Absicherung (täglicher SEO-Check, siehe vercel.json)
CRON_SECRET=

# GitHub-Token mit Schreibzugriff NUR auf postblitzblank-ai/clean-sparkle-berlin
# (Fine-grained Personal Access Token, Repository access auf genau dieses eine
# Repo beschränken, Permission "Contents: Read and write"). Ohne diesen Token
# bleiben automatische SEO-Meta-Änderungen reine Empfehlungen.
WEBSITE_GITHUB_TOKEN=
